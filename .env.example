# Placeholder only. Do not put real credentials in this example file.
# Copy this file to .env, then replace YOUR-PASSWORD with your real
# Supabase database password from the Supabase dashboard.
#
# Leave DISABLE_DATABASE set to true for live-only mode.
DISABLE_DATABASE="true"

# Optional. Only needed if you want Prisma/Postgres caching and history.
# DATABASE_URL uses Supabase connection pooling for Prisma Client.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional. DIRECT_URL is used by Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

EA_API_BASE_URL="https://proclubs.ea.com/api/fc"

EA_PLATFORM="common-gen5"

# Optional. Required only if you expose /api/cron/refresh-stats publicly.
CRON_SECRET="replace-with-a-long-random-secret"

# Optional cache/refresh tuning.
EA_CACHE_TTL_SECONDS="600"
EA_LEADERBOARD_CACHE_TTL_SECONDS="600"
EA_PROFILE_CACHE_TTL_SECONDS="600"
EA_REFRESH_CLUB_LIMIT="30"
EA_REFRESH_PLAYER_CLUB_SCAN_LIMIT="8"
EA_REFRESH_MAX_CLUBS="25"
